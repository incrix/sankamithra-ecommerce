# Copy to .env.local and fill in. Never commit the filled version.

# --- Database (required in production) -------------------------------------
# DynamoDB. Without these the app writes JSON to disk, which fails on any
# serverless host. Create the tables with: node scripts/dynamo-setup.mjs --write
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMO_TABLE_PREFIX=sankamithra_

# --- Documents -------------------------------------------------------------
# The price list PDF and admin uploads. NOT DynamoDB: an item there stops at
# 400 KB and the price list is allowed 14 MB.
S3_MEDIA_BUCKET=
S3_MEDIA_PREFIX=media/

# Kept only for scripts/migrate-mongo-to-dynamo.mjs. The app never reads it.
MONGODB_URI=
MONGODB_DB=

# --- Site ------------------------------------------------------------------
# Canonical URLs, sitemap and structured data are built from this.
NEXT_PUBLIC_SITE_URL=https://thunder.sankamithra.com
# Where product images and the catalogue seed are hosted.
NEXT_PUBLIC_ASSET_BASE=https://thunder.sankamithra.com/database

# --- Images -----------------------------------------------------------------
# Product photos. Uploads are signed server-side; the secret never reaches the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Outgoing mail ---------------------------------------------------------
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=noreply@teamincrix.com
MAIL_PASSWORD=
MAIL_NAME=Sankamithra Thunder World
ORDER_MAIL=sankamithrathunderworld@gmail.com
ORDER_MAIL_CC=

# --- Admin auth ------------------------------------------------------------
# Generate both with: node scripts/admin-secrets.mjs
ADMIN_JWT_SECRET=
ADMIN_PASSWORD_HASH=
